# ========================
# Environment Configuration
# ========================
ENV=dev  # dev | staging | prod

# ========================
# Firebase
# ========================
FIREBASE_PROJECT_ID=lexbot-pro
FIREBASE_CREDENTIALS=/path/to/firebase-adminsdk.json  # Path to your Firebase credentials
FIREBASE_CREDENTIALS_DEFAULT=/path/to/firebase-adminsdk.json
FIREBASE_STORAGE_BUCKET=lexbot-pro.firebasestorage.app

# ========================
# Session & Cookies
# ========================
COOKIE_NAME=fb_session
SESSION_HOURS=8
COOKIE_SECURE=false       # Set to true in production (HTTPS)
COOKIE_SAMESITE=lax
COOKIE_PATH=/
# COOKIE_DOMAIN=app.lexbot.pro  # Set in production so auth cookies stay on the app subdomain

# ========================
# CORS / Trusted Hosts
# ========================
# CORS_ALLOW_ORIGINS=["https://app.lexbot.pro"]
# TRUSTED_HOSTS=["app.lexbot.pro"]
PUBLIC_APP_URL=https://app.lexbot.pro

# ========================
# RAG / Embedding Configuration
# ========================
RAG_EMBEDDER=openai
OPENAI_API_KEY=your-openai-api-key-here  # Required for embedding and LLM calls
RAG_EMBED_MODEL=text-embedding-3-small
RAG_VECTORSTORE=pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=lbpr
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
RAG_EMBED_DIM=1536

# ========================
# Hybrid Search Settings
# ========================
RAG_HYBRID_FUSION=rrf       # Reciprocal rank fusion
RAG_HYBRID_ALPHA=0.5        # Weight for combining dense/sparse results
RAG_HYBRID_DUAL_INDEX=1     # Whether to use separate dense/sparse indexes
PINECONE_INDEX_DENSE=lbpr-dense
PINECONE_INDEX_SPARSE=lbpr-sparse

# ========================
# Tokenizer
# ========================
TOKENIZER_MODEL=cl100k_base  # Optional: override encoding model

# ========================
# Usage Limits
# ========================
LIMITS_FREE_MESSAGES=50
LIMITS_FREE_UPLOAD_TOKENS=100000
LIMITS_PRO_MESSAGES=2000
LIMITS_PRO_UPLOAD_TOKENS=20000000
LIMITS_PRO_WORKFLOW_TOKENS=5000000

# ========================
# Redis
# ========================
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# REDIS_PASSWORD=your-redis-password


# ========================
# Transcription (OpenAI Audio API)
# ========================
# OpenAI API key is also used for embeddings/chat.
# OPENAI_API_KEY=sk-...

# Location is kept for API compatibility; OpenAI is a global API.
STT_LOCATION=openai

# Default transcription model (overrideable via query param `model=`).
STT_MODEL=gpt-4o-mini-transcribe

# Default diarization-capable model used when `diarization=1`.
STT_MODEL_DIARIZE=gpt-4o-transcribe-diarize

# Comma-separated list used when client does not provide languages (BCP-47 accepted).
STT_DEFAULT_LANGUAGE_CODES=en-US,cs-CZ,it-IT

# OpenAI transcriptions API supports uploads up to 25MB.
STT_MAX_BYTES=26214400

# Legacy (no longer used) — kept so older envs don't break if they still include them.
STT_USE_STREAMING=0
STT_STREAMING_CHUNK_BYTES=15000
STT_ALLOW_M4A_MP4=1
STT_ENABLE_PUNCTUATION=1
STT_ENABLE_DIARIZATION_DEFAULT=0
STT_DIARIZATION_MIN_SPEAKERS=2
STT_DIARIZATION_MAX_SPEAKERS=6

# Transcription usage caps (billed audio seconds)
# Free: 5 minutes/month. Pro/Paid: 1000 minutes/month.
LIMITS_FREE_TRANSCRIBE_SECONDS=300
LIMITS_PRO_TRANSCRIBE_SECONDS=60000

# OCR usage caps (images/pages)
# Free: 5 images/month. Pro/Paid: 1000 images/month.
LIMITS_FREE_OCR_IMAGES=5
LIMITS_PRO_OCR_IMAGES=1000

# ========================
# Observability (Grafana Cloud / OpenTelemetry)
# ========================
# Local defaults below will work on localhost once you also set the Grafana endpoint + headers.
# For production, set these in Doppler instead of committing real values here.
OTEL_SERVICE_NAME=lbpr-api-local
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development,deployment.environment.name=development,service.namespace=my-application-group
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<grafana-cloud-token>
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
# Optional: drop noisy health checks from traces/metrics.
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/healthz,/v1/healthz

# Optional while debugging locally:
# OTEL_TRACES_EXPORTER=console,otlp
# OTEL_METRICS_EXPORTER=console,otlp
# OTEL_METRIC_EXPORT_INTERVAL=15000

# Production Doppler example:
# OTEL_SERVICE_NAME=lbpr-api
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,deployment.environment.name=production,service.namespace=my-application-group
