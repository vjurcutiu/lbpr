ENV=dev
FIREBASE_PROJECT_ID=lexbot-pro
# Use one of the two; first that exists wins
FIREBASE_CREDENTIALS=/run/secrets/firebase_sa.json
FIREBASE_CREDENTIALS_DEFAULT=/run/secrets/firebase_sa.json

COOKIE_NAME=fb_session
SESSION_HOURS=8
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/
# COOKIE_DOMAIN=app.example.com

# For CORS/hosts (set in prod)
# CORS_ALLOW_ORIGINS=["https://app.example.com"]
# TRUSTED_HOSTS=["app.example.com"]
