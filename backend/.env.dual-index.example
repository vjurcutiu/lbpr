# backend/.env.dual-index.example
# --- Pinecone dual-index hybrid ---
RAG_VECTORSTORE=pinecone
RAG_HYBRID_DUAL_INDEX=1

# Use a base name or explicit names
PINECONE_INDEX=lbpr
# PINECONE_INDEX_DENSE=lbpr-dense
# PINECONE_INDEX_SPARSE=lbpr-sparse

PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embedding model dimension (OpenAI text-embedding-3-small = 1536, -large = 3072)
RAG_EMBED_DIM=1536
