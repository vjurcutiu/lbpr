// Firestore Security Rules for Firebase Authentication + Stripe Extension + Per-User Chat
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Public Catalog (read-only) ----------
    match /products/{productId} {
      allow read: if true;
      allow write: if false;

      match /prices/{priceId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ---------- Per-User Stripe Mirror ----------
    match /customers/{uid} {
      allow read: if isSelf(uid);
      allow write: if false; // managed by the extension

      // --- Checkout Sessions ---
      // Checkout sessions are created by the FastAPI backend so price selection
      // stays server-side. Users can only read the extension-managed result URL/error.
      match /checkout_sessions/{sessionId} {
        allow create, update, delete: if false;
        allow read: if isSelf(uid);
      }

      // --- Customer Portal Sessions ---
      match /portal_sessions/{portalId} {
        allow create: if isSelf(uid)
                      && request.resource.data.keys().hasOnly([
                        "return_url","configuration","locale","flow_data"
                      ]);
        allow read: if isSelf(uid);
        allow update, delete: if false;
      }

      // --- Subscriptions (extension-managed) ---
      match /subscriptions/{subId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // --- Payments (extension-managed) ---
      match /payments/{payId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // --- Invoices (extension-managed) ---
      match /invoices/{invId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // ---------- Per-User Chat (read/write only by the owner) ----------
    // Structure used by the app:
    // users/{uid}/chat/{namespace}/conversations/{cid}
    // users/{uid}/chat/{namespace}/conversations/{cid}/messages/{mid}
    match /users/{uid} {
      // Optional: allow reading/writing other user-profile docs stored directly under /users/{uid}
      allow read, write: if isSelf(uid);

      match /chat/{namespace} {
        allow read, write: if isSelf(uid);

        match /conversations/{cid} {
          allow read, write: if isSelf(uid);

          // You can tighten validation by whitelisting fields on create/update if desired.
          match /messages/{mid} {
            allow read, write: if isSelf(uid);
          }
        }
      }
    }

    // ---------- Deny everything else by default ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
