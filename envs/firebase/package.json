{
  "name": "lbp-env-firebase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Programmatic export/apply of Firebase project settings (Auth, Rules, Extensions, Functions config) to/from an SSOT.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "export": "dotenv -e ./.env -- tsx src/index.ts export",
    "apply": "dotenv -e ./.env -- tsx src/index.ts apply"
  },
  "bin": {
    "firebase-env": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "execa": "^9.4.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^164.1.0",
    "picocolors": "^1.1.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.32",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}