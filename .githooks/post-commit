#!/usr/bin/env sh

printf '%s\n' '[post-commit] running: make synczip'

if ! command -v make >/dev/null 2>&1; then
  printf '%s\n' "[post-commit] skipped: 'make' is not available on PATH, so 'make synczip' was not run."
  exit 0
fi

if ! make -n synczip >/dev/null 2>&1; then
  printf '%s\n' "[post-commit] skipped: 'make synczip' is unavailable in this clone, so nothing was run."
  exit 0
fi

make synczip
status=$?

if [ "$status" -eq 0 ]; then
  printf '%s\n' "[post-commit] done: 'make synczip' completed successfully."
  exit 0
fi

printf '%s\n' "[post-commit] failed: 'make synczip' exited with status $status."
exit 0
