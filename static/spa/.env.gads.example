# Google Ads (gtag.js) — Conversion tracking for signups
# Your Google Ads ID (looks like AW-XXXXXXXXX)
VITE_GADS_ID=AW-XXXXXXXXX
# Conversion label for the "Sign up" conversion action (from Google Ads UI)
VITE_GADS_SIGNUP_LABEL=AbCdEfGhIjkLmNoPq
# Optional: start in consent-denied mode (recommended for EEA until user accepts)
VITE_GADS_DEFAULT_DENY=1
