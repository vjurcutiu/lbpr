// Firestore Security Rules for Firebase Authentication + Stripe Extension
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Public Catalog (read-only) ----------
    match /products/{productId} {
      allow read: if true;
      allow write: if false;

      match /prices/{priceId} {
        allow read: if true;
        allow write: if false;
      }
    }


    // ---------- Canonical App User Record ----------
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // managed by the backend/admin SDK
    }

    // ---------- Per-User Stripe Mirror ----------
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // managed by the extension

      // --- Checkout Sessions ---
      // Checkout sessions are created by the FastAPI backend so price selection
      // stays server-side. Users can only read the extension-managed result URL/error.
      match /checkout_sessions/{sessionId} {
        allow create, update, delete: if false;
        allow read: if request.auth != null && request.auth.uid == uid;
      }

      // --- Customer Portal Sessions ---
      match /portal_sessions/{portalId} {
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly([
                        "return_url","configuration","locale","flow_data"
                      ]);
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }

      // --- Subscriptions (extension-managed) ---
      match /subscriptions/{subId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // --- Payments (extension-managed) ---
      match /payments/{payId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // --- Invoices (extension-managed) ---
      match /invoices/{invId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
